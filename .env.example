# Copy to .env for local development. NEVER commit real values.
# In production on cPanel these are set in Setup Node.js App → Environment
# variables (see DEPLOY.md), not in a file.

# MongoDB (on the VPS): the linton_ma database and its own user. Needed for
# dev, for the build (pages are prerendered from the database) and in
# production.
DATABASE_URI=mongodb://linton_ma:PASSWORD@VPS_IP:27017/linton_ma?authSource=linton_ma
# Long random string (openssl rand -hex 32), not linton-id's. Use the same
# value here and on cPanel; changing it logs everyone out of the admin.
PAYLOAD_SECRET=

# Optional: where images uploaded in the admin are stored. Defaults to
# public/media in the app folder. An absolute path outside the app folder
# keeps them safe from deploys.
# MEDIA_DIR=

# Outgoing contact-form mail. All three are required: without any one of them,
# enquiries are only saved in the admin (Messages) and written to the log.
# SMTP_HOST is your mail server, usually mail.linton.ma on cPanel.
SMTP_HOST=mail.linton.ma
SMTP_USER=
SMTP_PASSWORD=
# 465 (implicit TLS, default) or 587 (STARTTLS)
SMTP_PORT=465
