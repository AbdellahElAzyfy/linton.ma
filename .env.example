# Copy to .env for local development. NEVER commit real values.
# In production on cPanel these are set in Setup Node.js App → Environment
# variables (see DEPLOY.md), not in a file.

# Outgoing contact-form mail. All three are required: without any one of them,
# enquiries are only written to the server log (see lib/notify.js).
# SMTP_HOST is your mail server, usually mail.linton.ma on cPanel.
SMTP_HOST=mail.linton.ma
SMTP_USER=
SMTP_PASSWORD=
# 465 (implicit TLS, default) or 587 (STARTTLS)
SMTP_PORT=465
